# Environment Variables
# Copy this file to .env and fill in your values

# Breeze Connect Configuration (Real-time Market Data)
# Get your API credentials from https://www.angelbroking.com/breeze/
BREEZE_API_KEY=your-breeze-api-key
BREEZE_SECRET_KEY=your-breeze-secret-key
BREEZE_SESSION_KEY=  # Auto-generated on login
BREEZE_USE_PRODUCTION=True  # Set to False for sandbox/test mode

# OpenAI API Key (optional, for future AI features)
OPENAI_API_KEY=your-api-key-here

# Flask Configuration
FLASK_PORT=5000
DEBUG_MODE=False

# You can customize technical indicator periods here if needed
# See config.py for all available options
